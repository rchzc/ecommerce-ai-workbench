# ============================================================================
# ecom-data-platform 配置示例
# 复制成 .env 后按需修改。
#
# ⚠️ 只想跑起来看效果的话：**什么都不用配**。
#    `python demo.py` 和 `pytest` 都是全程离线的，不带 .env 也能跑完整链路。
#    下面这些变量只在你真接平台 / 真推飞书时才需要填。
# ============================================================================

# ---------------------------------------------------------------------------
# 共享层配置（模型接入 / 检索 / 记忆 / 日志）
# 完整的键说明见 ecom-agent-shared 仓库的 .env.example，这里只留最常用的几个。
# 本包不复制那张厂商 preset 表 —— 换厂商只改这里的 LLM_PROVIDER 一处。
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_API_KEY=
VECTOR_BACKEND=lexical
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 数据目录
# 只改这一个变量，docs / import / jobs / reports / sales / 流水线状态文件一起走。
# 容器部署时把卷挂到这里即可，不用改代码。
# ---------------------------------------------------------------------------
# DATA_DIR=
# SALES_DATA_DIR=

# ---------------------------------------------------------------------------
# 每日流水线（09:00 跑一次：刷新数据 → 出日报 →（可选）模型解读 → 推飞书）
# ---------------------------------------------------------------------------
PIPELINE_ENABLED=true
PIPELINE_SCHEDULE=09:00
# 是否让模型写一段经营解读。默认关：规则预警已可解释，
# 模型解读是加分项不是必需品，开着就是每天固定烧 token。
PIPELINE_USE_LLM=false
# 是否在跑之前先拉当日数据。关了就直接对已有数据出日报。
PIPELINE_REFRESH_DATA=true

# ---------------------------------------------------------------------------
# 批量任务
# ---------------------------------------------------------------------------
# 单次提交行数上限：防止一次贴几千行把模型额度打满
BATCH_MAX_ROWS=200
# 并发度：太高触发厂商限流，太低批量就没有意义
BATCH_CONCURRENCY=3

# ---------------------------------------------------------------------------
# 数据入口 · Shopify
# 评论走 CSV 导出：Shopify 原生 Admin API 不含评论接口，这是事实，不伪造。
# ---------------------------------------------------------------------------
SHOPIFY_SHOP=
SHOPIFY_TOKEN=
SHOPIFY_API_VERSION=2024-01

# ---------------------------------------------------------------------------
# 数据入口 · Amazon SP-API（LWA OAuth2，refresh_token 换 access_token 后缓存）
# ---------------------------------------------------------------------------
AMAZON_SELLER_ID=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_REGION=na

# ---------------------------------------------------------------------------
# 数据出口 · 飞书多维表格
# 四件套**缺一不可**：配了一半时同步接口仍会返回 503，
# 不会静默降级成 mock 把"没连通"伪装成"同步成功"。
# 不填也不影响日报生成与看板 —— 只有"同步到飞书"这一步不可用。
# ---------------------------------------------------------------------------
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_TABLE_ID=
