# ============================================================
# 复制本文件为 .env 并填入真实 Key：cp .env.example .env
# .env 已在 .gitignore 中，不会上传 GitHub
# ============================================================

# ---------- 模型厂商 ----------
# 可选：dashscope(阿里云百炼) / deepseek / openai / ollama
# 切换厂商只改这一行，业务代码零改动
LLM_PROVIDER=dashscope

# 阿里云百炼控制台 -> API Key 管理
# 免费额度说明：新用户开通送 7000 万 tokens（每模型输入输出各 100 万，有效期 90 天）
# 注意：免费额度仅在【华北 2（北京）】地域生效，不要改下面的 API Base
LLM_API_KEY=

# 一般不需要改（config.py 里有各厂商的 preset 默认值）
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_LIGHT=qwen-plus
# MODEL_HEAVY=qwen-max
# MODEL_EMBEDDING=text-embedding-v3

# ---------- RAG 参数 ----------
# 每个 Agent 检索的切片数
TOP_K=4
# 切片目标长度（字符）
CHUNK_SIZE=600
# 相邻切片重叠长度，避免切断语义
CHUNK_OVERLAP=50

# ---------- 服务 ----------
REQUEST_TIMEOUT=120
CORS_ORIGINS=*

# ---------- 真实店铺数据连接器（可选）----------
# 仅当你要接入客户真实 Shopify 店铺时才填。不填则用文档型知识库（默认）。
# Shopify 后台 Apps -> 创建 Custom App -> 拿到 Admin API Access Token
SHOPIFY_SHOP=
SHOPIFY_TOKEN=
# 评论来自评论 App / 后台 CSV 导出，放到 backend/data/import/reviews.csv
# 字段：product,rating,content（或中文表头 商品,评分,内容）

# ---------- 向量库持久化（可选）----------
# CHROMA_DIR=backend/chroma_db

# ---------- 批量任务（可选）----------
# 单个批量任务的行数上限（防止一次提交几千行把模型额度打满）
BATCH_MAX_ROWS=200
# 批量任务的并发度：太高触发厂商限流，太低没有意义
BATCH_CONCURRENCY=3

# ---------- 对外 Webhook 鉴权（可选）----------
# /api/hooks/* 给 n8n / Dify / Coze 调用，必须配。
# 不配则 Webhook 端点直接 503，不做静默放行。
# 建议用 openssl rand -hex 32 生成
WORKFLOW_API_KEY=
